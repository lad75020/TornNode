    "memory:playbook": "node scripts/addPlaybook.js",
    "memory:quality": "node scripts/memoryQuality.js",
    "memory:report": "node scripts/memoryReport.js",
    "memory:sanitizeExpo": "node scripts/memorySanitizeExpo.js --mode delete",
    "memory:purge": "node scripts/memoryPurge.js",
    "memory:purge:relations": "node scripts/memoryPurgeRelations.js"
