    "dev": "node server.cjs --no-test --log --host 127.0.0.1 --port 3104 --https",
    "start": "node server.cjs",
    "build:static": "vite build && rm -rf public/assets && cp -r client/dist/* public/",
    "memory:index": "MEMORY_MCP_DISABLE_LEGACY_PUSH=1 node scripts/buildMemoryIndex.js && node scripts/pushMemoryMcp.js",
